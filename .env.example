# ── Backend ────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of allowed CORS origins (frontend URLs). No trailing slash.
FRONTEND_ORIGINS=http://localhost:5173,https://molde-app.parolin.net

# Postgres connection string. Local dev default below; production value comes from Coolify.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/molde-app

# JWT — signs/verifies session tokens (REQUIRED in prod, use a DIFFERENT value than dev).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me

# Google OAuth (shared client for *.parolin.net). In DEV you can sign in via the mock form.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional allowlist restricting who can log in (comma-separated emails). Empty/absent =
# any Google account can log in (fine for public/multi-user apps). For personal/family
# apps, ALWAYS set this in production — see molde-brain.md §Auth flow.
# ALLOWED_EMAILS=you@example.com,partner@example.com

# ── Optional: AI provider (opt-in, -EnableAI) ────────────────────────────────
# A cadeia é a mesma em todo app da stack (2026-07-29): Gemini → Ollama local →
# Poe. Quem lê estas variáveis é backend/src/services/cadeiaIa.ts.
#
# AI_API_KEY aceita LISTA separada por vírgula — uma chave por conta Google. A
# cota do free tier do Gemini é DIÁRIA e por PROJETO, então mais contas = mais
# cota; a chave que responder 429 de cota é abandonada na hora.
# AI_API_KEY=chave1,chave2,chave3
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.6-flash
# AI_MODEL_FALLBACK=gemini-3.5-flash-lite
# AI_CLOUD_TIMEOUT_MS=240000
#
# Ollama local (grátis, depende da máquina ligada). AI_LOCAL_MODEL_VISAO é
# obrigatório se o app manda FOTO: imagem em modelo de texto não dá erro, ele
# responde qualquer coisa. Desde 2026-08-16 o modelo local principal tem visão
# nativa, então as duas variáveis apontam para ele — mas isso só foi medido em
# imagem sintética, não em foto de cliente (o spike de manuscrito segue aberto).
# ATENÇÃO: ele devolve JSON dentro de cerca markdown mesmo com format:"json" —
# tire a cerca antes do JSON.parse (o Cota4 faz isso em parseJsonLoose.ts).
# AI_LOCAL_BASE_URL=http://localhost:11434
# AI_LOCAL_MODEL=qwen3.8:27b-mlx
# AI_LOCAL_MODEL_VISAO=qwen3.8:27b-mlx
#
# Poe (rápido, consome assinatura) — último da fila por isso.
# POE_API_KEY=
# POE_MODEL=gpt-5.4-mini
#
# NÃO copie nome de modelo daqui sem conferir: este arquivo é fotografia. A fonte
# viva é o Models-Benchmark (X:\Obsidian\Brain\Projects\Models-Benchmark), que
# mede disponibilidade todo dia com chamada real. Dois defaults documentados como
# "funcionando" morreram em dois meses — inclusive o antigo default deste arquivo
# (glm-4v-flash, da Z.AI, hoje 400 "modelo não existe").

# ── Optional: S3-compatible object storage / Cloudflare R2 (opt-in) ──────────
# Enable only if the app uploads files (photos, documents).
# S3_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET=molde-app-assets
# S3_ACCESS_KEY=replace-me
# S3_SECRET_KEY=replace-me
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true

# ── Frontend (build-time — set in Cloudflare Pages for production) ───────────
VITE_API_BASE_URL=http://localhost:3000
